{
  "opencollection": "1.0.0",
  "info": {
    "name": "Legacy API (v1) Account Tag API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Tag",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OData end point to get a list of all tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.practicepanther.com/api/tag",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "/OAuth/Authorize",
              "accessTokenUrl": "/OAuth/Token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "OData end point to get a list of all tags"
        }
      ]
    }
  ],
  "bundled": true
}